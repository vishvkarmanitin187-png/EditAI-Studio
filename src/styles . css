*{
  box-sizing:border-box;
}

body{
  margin:0;
  font-family:Inter,Arial,sans-serif;
  background:#07080d;
  color:#fff;
}

button,
input,
textarea{
  font:inherit;
}

button{
  cursor:pointer;
}

.app{
  min-height:100vh;
  background:
    radial-gradient(
      circle at 50% -20%,
      #30234d,
      #0b0c12 45%,
      #07080d
    );
}

.topbar{
  height:64px;
  padding:0 14px;
  display:flex;
  align-items:center;
  justify-content:space-between;
  border-bottom:1px solid #272936;
  background:#0c0d14ee;
  position:sticky;
  top:0;
  z-index:20;
}

.logo{
  display:flex;
  align-items:center;
  gap:9px;
  font-size:19px;
}

.logo span{
  width:32px;
  height:32px;
  display:grid;
  place-items:center;
  border-radius:9px;
  background:linear-gradient(
    135deg,
    #805cff,
    #ff4dc4
  );
  font-weight:900;
}

.topButtons{
  display:flex;
  gap:7px;
}

.topButtons button{
  border:1px solid #2b2d39;
  background:#1a1b25;
  color:#fff;
  border-radius:10px;
  padding:8px 11px;
}

.topButtons button:disabled{
  opacity:.3;
}

.topButtons .export,
.mainButton{
  background:linear-gradient(
    135deg,
    #795bff,
    #d64bff
  );
  border:0;
  font-weight:800;
}

.editor,
.timelineCard,
.tools{
  width:min(1050px,calc(100% - 20px));
  margin:10px auto;
  border:1px solid #272936;
  border-radius:17px;
  background:#11121a;
  overflow:hidden;
}

.previewBox{
  height:min(62vh,560px);
  min-height:300px;
  background:#05060a;
  display:grid;
  place-items:center;
  position:relative;
  overflow:hidden;
}

.previewBox video,
.previewBox img{
  max-width:100%;
  max-height:100%;
  object-fit:contain;
}

.empty{
  text-align:center;
  color:#a7abba;
  padding:20px;
}

.empty h2{
  color:#fff;
  margin:12px 0 5px;
}

.emptyIcon{
  width:62px;
  height:62px;
  margin:auto;
  display:grid;
  place-items:center;
  border-radius:18px;
  background:linear-gradient(
    135deg,
    #795bff,
    #ff4fc8
  );
  font-size:27px;
  font-weight:900;
}

.empty p{
  font-size:13px;
}

.mainButton,
.secondary{
  padding:11px 16px;
  border-radius:11px;
  color:#fff;
}

.secondary{
  background:#1c1e28;
  border:1px solid #2b2d39;
}

.player{
  height:52px;
  display:flex;
  align-items:center;
  gap:10px;
  padding:0 12px;
  background:#0c0d13;
}

.player button{
  width:36px;
  height:34px;
  border:0;
  border-radius:9px;
  background:#242631;
  color:#fff;
}

.player input{
  flex:1;
}

.canvasText{
  position:absolute;
  transform:translate(-50%,-50%);
  font-weight:900;
  text-shadow:0 2px 9px #000;
  pointer-events:none;
}

.timelineCard{
  padding:12px;
}

.timelineTitle{
  display:flex;
  justify-content:space-between;
  color:#adb1bf;
  font-size:13px;
}

.timeline{
  min-height:70px;
  display:flex;
  gap:8px;
  overflow:auto;
  padding:10px 0;
}

.clip{
  min-width:160px;
  padding:11px;
  text-align:left;
  border-radius:10px;
  border:1px solid #2a2c39;
  background:#191a24;
  color:#fff;
}

.clip.selected{
  border-color:#9c6cff;
  box-shadow:0 0 0 1px #9c6cff55 inset;
}

.clip b{
  display:inline-grid;
  place-items:center;
  width:23px;
  height:23px;
  margin-right:6px;
  border-radius:6px;
  background:#292b37;
  font-size:11px;
}

.timelineEmpty{
  width:100%;
  display:grid;
  place-items:center;
  color:#656a7b;
  font-size:13px;
}

.timelineButtons{
  display:flex;
  gap:7px;
  overflow:auto;
}

.timelineButtons button{
  white-space:nowrap;
  padding:9px 12px;
  border:1px solid #2b2d39;
  border-radius:9px;
  background:#1b1d27;
  color:#fff;
}

.tabs{
  display:flex;
  gap:4px;
  padding:7px;
  overflow:auto;
  border-bottom:1px solid #282a36;
}

.tabs button{
  white-space:nowrap;
  border:0;
  border-radius:9px;
  padding:10px 13px;
  background:transparent;
  color:#9da1b1;
}

.tabs button.active{
  background:#292338;
  color:#fff;
}

.toolContent{
  padding:14px;
}

.grid{
  display:grid;
  grid-template-columns:repeat(4,1fr);
  gap:9px;
}

.tool{
  min-height:80px;
  display:flex;
  flex-direction:column;
  justify-content:center;
  align-items:center;
  gap:7px;
  border:1px solid #292b38;
  border-radius:12px;
  background:#191a24;
  color:#fff;
}

.tool b{
  font-size:22px;
}

.form{
  display:flex;
  flex-direction:column;
  gap:10px;
}

.form textarea{
  min-height:90px;
  resize:vertical;
  padding:12px;
  border-radius:11px;
  border:1px solid #2a2c38;
  background:#0c0d13;
  color:#fff;
}

.upload{
  padding:20px;
  text-align:center;
  border:1px dashed #484b5a;
  border-radius:12px;
  color:#c1c4cf;
}

.upload input{
  display:block;
  margin:12px auto 0;
}

.controls{
  display:grid;
  gap:15px;
}

.controls label{
  display:grid;
  grid-template-columns:1fr auto;
  gap:8px;
  color:#c7cad4;
  font-size:13px;
}

.controls input{
  grid-column:1 / 3;
  width:100%;
}

.stickers{
  display:grid;
  grid-template-columns:repeat(5,1fr);
  gap:9px;
}

.stickers button{
  height:58px;
  border:1px solid #292b38;
  border-radius:12px;
  background:#191a24;
  font-size:28px;
}

.info{
  color:#858a9b;
  font-size:12px;
  line-height:1.5;
}

@media(max-width:650px){

  .topbar{
    height:58px;
  }

  .logo{
    font-size:17px;
  }

  .editor,
  .timelineCard,
  .tools{
    width:calc(100% - 12px);
    border-radius:14px;
  }

  .previewBox{
    height:46vh;
    min-height:260px;
  }

  .grid{
    grid-template-columns:repeat(2,1fr);
  }

  .tabs button{
    padding:9px 10px;
  }

}